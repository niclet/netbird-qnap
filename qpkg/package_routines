######################################################################
# Netbird VPN QPKG - package install/remove routines
######################################################################

# Returns success when the given config file carries a non-empty SETUP_KEY.
# Sourced in a subshell so the caller's environment is untouched.
netbird_has_setup_key() {
    [ -f "$1" ] || return 1
    (
        SETUP_KEY=""
        . "$1" >/dev/null 2>&1
        [ -n "$SETUP_KEY" ]
    )
}

pkg_pre_install() {
    true
}

pkg_post_install() {
    CONF=/etc/config/qpkg.conf
    QPKG_ROOT=$(/sbin/getcfg $QPKG_NAME Install_Path -f ${CONF})
    NETBIRD_CONF="${QPKG_ROOT}/netbird.conf"

    chmod +x "${QPKG_ROOT}/netbird"
    chmod +x "${QPKG_ROOT}/netbird.sh"
    chmod +x "${QPKG_ROOT}/web/cgi-bin/netbird-api.cgi" 2>/dev/null

    # Clean stale config from previous versions
    pkill -f "busybox httpd -p 58090" 2>/dev/null
    pkill -f "busybox httpd -p 8090" 2>/dev/null

    # netbird.conf is now tracked through QPKG_CONFIG, which preserves user
    # edits across upgrades. The very first install that adopts it has no
    # recorded md5 for the file, so QDK sets the existing one aside as
    # .qdkorig and lays down the stock template. Put the real settings back.
    # .qdksave is the same situation on a later upgrade whose template changed.
    for _saved in "${NETBIRD_CONF}.qdkorig" "${NETBIRD_CONF}.qdksave"; do
        [ -f "$_saved" ] || continue
        if ! netbird_has_setup_key "$NETBIRD_CONF" && netbird_has_setup_key "$_saved"; then
            cp -p "$_saved" "$NETBIRD_CONF"
            /sbin/log_tool -t1 -uSystem -p127.0.0.1 -mlocalhost \
                -a "Netbird VPN restored existing settings from $(basename "$_saved")"
        fi
    done

    chmod 666 "$NETBIRD_CONF" 2>/dev/null
    mkdir -p /etc/netbird 2>/dev/null
    /sbin/log_tool -t1 -uSystem -p127.0.0.1 -mlocalhost -a "Netbird VPN QPKG installed"
}

PKG_PRE_REMOVE="{
    CONF=/etc/config/qpkg.conf
    QPKG_ROOT=\$(/sbin/getcfg netbird Install_Path -f \${CONF})
    if [ -x \"\${QPKG_ROOT}/netbird.sh\" ]; then
        \${QPKG_ROOT}/netbird.sh stop 2>/dev/null
    fi
}"

PKG_POST_REMOVE="{
    rm -f /usr/local/bin/netbird 2>/dev/null
    # Current web UI (self-contained busybox httpd, see netbird.sh WEBUI_PORT)
    if [ -f /var/run/netbird-httpd.pid ]; then
        kill \"\$(cat /var/run/netbird-httpd.pid)\" 2>/dev/null
        rm -f /var/run/netbird-httpd.pid
    fi
    pkill -f 'busybox httpd -f -p 8095 ' 2>/dev/null
    # Leftovers from older releases' Apache-based web UI
    rm -f /etc/container-proxy.d/netbird.conf 2>/dev/null
    rm -f /etc/default_config/apache-netbird.conf 2>/dev/null
    for _pf in /etc/config/apache/extra/apache-proxy.conf /etc/default_config/apache/extra/apache-proxy.conf; do
        [ -f \"\$_pf\" ] && sed -i '/apache-netbird\.conf/d' \"\$_pf\" 2>/dev/null
    done
    [ -x /etc/init.d/thttpd.sh ] && /etc/init.d/thttpd.sh reload 2>/dev/null
    [ -x /etc/init.d/stunnel.sh ] && /etc/init.d/stunnel.sh reload 2>/dev/null
    rm -f /home/httpd/cgi-bin/netbird-api.cgi 2>/dev/null
    rm -f /home/Qhttpd/Web/netbird 2>/dev/null
    pkill -f 'busybox httpd -p 58090' 2>/dev/null
    pkill -f 'busybox httpd -p 8090' 2>/dev/null
    rm -f /var/run/netbird.pid 2>/dev/null
    rm -f /var/run/netbird.sock 2>/dev/null
    /sbin/log_tool -t1 -uSystem -p127.0.0.1 -mlocalhost -a \"Netbird VPN QPKG removed\"
}"
